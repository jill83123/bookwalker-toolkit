{
  "manifest_version": 3,
  "name": "BookWalker 小工具",
  "version": "2.0.0",
  "description": "統計 BookWalker 購書花費、本數與折數；購物車用原價試算實際折數與各活動。",
  "key": "",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://member.bookwalker.com.tw/*",
    "https://www.bookwalker.com.tw/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bookwalker.com.tw/product/*"
      ],
      "js": [
        "price-helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
